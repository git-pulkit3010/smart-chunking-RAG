# ==============================================================================
# Smart Chunking RAG - Environment Configuration
# ==============================================================================

# Your OpenRouter API Key (get one at https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# LLM Generation Model for answering queries
# Examples: openai/gpt-4o-mini, anthropic/claude-3.5-sonnet, google/gemini-2.5-flash
OPENROUTER_MODEL=openai/gpt-4o-mini

# Embedding Model Selection
# Recommended OpenRouter Model: openai/text-embedding-3-small ($0.02 / 1M tokens, 8192 context, 1536 dim)
# Alternative OpenRouter Models: baai/bge-m3 ($0.01 / 1M tokens), openai/text-embedding-3-large ($0.13 / 1M tokens)
# Local fallback model: all-MiniLM-L6-v2 (offline, runs locally via sentence-transformers)
EMBED_MODEL=openai/text-embedding-3-small

# Embedding Provider: 'openrouter' (default, uses OpenRouter Embeddings API) or 'local' (sentence-transformers)
EMBED_PROVIDER=openrouter

# Vector Store Configuration
CHROMA_PATH=./chroma_db
COLLECTION_NAME=papers

# Intelligent Chunking Parameters
# Maximum tokens allowed before a section is split semantically
MAX_CHUNK_TOKENS=512

# Cosine similarity threshold for semantic boundary detection (0.0 to 1.0)
# Consecutive sentences with similarity below this threshold trigger a new chunk
SEMANTIC_SIMILARITY_THRESHOLD=0.65

# Retrieval Configuration
TOP_K_RETRIEVAL=5
